{
  "name": "micky-assistant-worker",
  "version": "1.0.0",
  "description": "Micky Assistant Unlimited - Telegram Bot + BYOK endpoint on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate": "wrangler d1 execute micky-db --file=migrations/0001_init.sql",
    "db:query": "wrangler d1 execute micky-db --command",
    "secret:set": "wrangler secret put",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20241101.0",
    "bcryptjs": "^2.4.3",
    "grammy": "^1.30.0",
    "itty-router": "^5.0.0",
    "nanoid": "^5.0.7",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.6.0",
    "vitest": "^2.1.5",
    "wrangler": "^3.85.0"
  }
}
